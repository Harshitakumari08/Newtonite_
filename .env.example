# Newtonite / Operations Under Pressure - Root Environment Configuration
# Copy to .env for Docker Compose overrides: cp .env.example .env

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ops
POSTGRES_PORT=5432

# Backend API & Worker
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ops
JWT_SECRET=dev-only-secret-change-me-in-production-please
JWT_TTL_MINUTES=720
IDEMPOTENCY_TTL_HOURS=24
OUTBOX_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:5173

# Frontend
API_URL=http://localhost:8000
